---
interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
  count?: number;
}
const { title, description, href, icon = '◆', count } = Astro.props;
---

<a href={href} class="card topic-card">
  <div class="topic-icon">{icon}</div>
  <h3 class="topic-title">{title}</h3>
  <p class="topic-desc">{description}</p>
  {count !== undefined && (
    <span class="topic-count">{count} article{count !== 1 ? 's' : ''}</span>
  )}
</a>

<style>
  .topic-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .topic-icon {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--accent);
  }

  .topic-title {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .topic-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    flex: 1;
    margin-bottom: 0.75rem;
  }

  .topic-count {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }
</style>
