---
interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
  count?: number;
}
const { title, description, href, icon = '◆', count } = Astro.props;
---

<a href={href} class="card topic-card">
  <div class="topic-topline">
    <div class="topic-icon">{icon}</div>
    <span class="topic-kicker">Topic</span>
  </div>
  <h3 class="topic-title">{title}</h3>
  <p class="topic-desc">{description}</p>
  {count !== undefined && (
    <span class="topic-count">{count} article{count !== 1 ? 's' : ''}</span>
  )}
</a>

<style>
  .topic-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .topic-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.78rem;
  }

  .topic-icon {
    font-size: 1.2rem;
    color: var(--accent);
    line-height: 1;
  }

  .topic-kicker {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--text-muted);
  }

  .topic-title {
    font-size: 1.08rem;
    margin-bottom: 0.48rem;
  }

  .topic-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    flex: 1;
    margin-bottom: 0.8rem;
    line-height: 1.55;
  }

  .topic-count {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }
</style>
