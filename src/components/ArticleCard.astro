---
interface Props {
  title: string;
  description: string;
  href: string;
  pubDate?: Date;
  tags?: string[];
  type?: string;
  featured?: boolean;
}
const { title, description, href, pubDate, tags = [], type, featured = false } = Astro.props;

const formattedDate = pubDate ? new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(pubDate) : null;
---

<a href={href} class:list={['card', 'article-card', { featured }]}>
  <div class="article-meta">
    {type && <span class="tag">{type}</span>}
    {formattedDate && <time datetime={pubDate?.toISOString()}>{formattedDate}</time>}
  </div>
  <h3 class="article-title">{title}</h3>
  <p class="article-desc">{description}</p>
  {tags.length > 0 && (
    <div class="article-tags">
      {tags.slice(0, 3).map(tag => (
        <span class="article-tag">{tag}</span>
      ))}
    </div>
  )}
</a>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    min-height: 220px;
  }

  .article-card.featured {
    border-color: color-mix(in srgb, var(--accent) 58%, var(--border));
    background:
      linear-gradient(160deg, color-mix(in srgb, var(--accent) 11%, transparent), transparent 45%),
      var(--bg-card);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.72rem;
    margin-bottom: 0.78rem;
    flex-wrap: wrap;
  }

  .article-meta time {
    font-size: 0.74rem;
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  .article-title {
    font-size: 1.16rem;
    margin-bottom: 0.5rem;
    line-height: 1.32;
    text-wrap: balance;
  }

  .article-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    flex: 1;
    margin-bottom: 0.9rem;
    line-height: 1.56;
  }

  .article-tags {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .article-tag {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-secondary) 78%, transparent);
    padding: 0.2em 0.56em;
    border-radius: 999px;
  }
</style>
