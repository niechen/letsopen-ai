---
interface Props {
  variant?: 'inline' | 'full';
}
const { variant = 'inline' } = Astro.props;
---

<div class:list={['subscribe-form', variant]}>
  {variant === 'full' && (
    <div class="subscribe-header">
      <span class="subscribe-kicker">Newsletter</span>
      <h2>Get the builder brief</h2>
      <p>Weekly signal on open source AI agents, app stacks, source posture, and tools worth building with.</p>
    </div>
  )}
  <form class="form" action="https://buttondown.com/api/emails/embed-subscribe/letsopenai" method="post" target="_blank">
    <input
      type="email"
      name="email"
      placeholder="you@example.com"
      required
      aria-label="Email address"
    />
    <button type="submit" class="btn btn-primary">Subscribe</button>
  </form>
  {variant === 'inline' && (
    <p class="form-note">Free builder brief. No spam.</p>
  )}
</div>

<style>
  .subscribe-form {
    width: 100%;
  }

  .subscribe-header {
    margin-bottom: 1.35rem;
  }

  .subscribe-kicker {
    display: inline-block;
    margin-bottom: 0.7rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .subscribe-header h2 {
    margin-bottom: 0.45rem;
  }

  .subscribe-header p {
    color: var(--text-secondary);
    max-width: 560px;
    margin-bottom: 0;
  }

  .form {
    display: flex;
    gap: 0.75rem;
    max-width: 560px;
  }

  .form input {
    flex: 1;
    padding: 0.8rem 0.95rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.92rem;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .form input::placeholder {
    color: var(--text-muted);
  }

  .form input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent);
  }

  .form-note {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .full {
    background:
      linear-gradient(160deg, color-mix(in srgb, var(--accent) 11%, transparent), transparent 45%),
      var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: 2.2rem;
  }

  @media (max-width: 560px) {
    .form {
      flex-direction: column;
    }

    .full {
      padding: 1.35rem;
    }
  }
</style>
