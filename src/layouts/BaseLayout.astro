---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  alternateLinks?: Array<{
    href: string;
    type: string;
    title?: string;
  }>;
  schema?: any;
}

const {
  title,
  description = 'The homepage for open source AI. High-signal coverage of the projects, tools, models, and agent systems that matter.',
  ogImage = '/og-default.svg',
  ogType = 'website',
  canonicalUrl,
  alternateLinks = [],
  schema,
} = Astro.props;

const siteTitle = title === 'Home' ? "Let's Open — Open source AI people can trust" : `${title} — Let's Open`;
const canonical = canonicalUrl || Astro.url.href;
const aiDiscoveryLinks = [
  { href: '/llms.txt', type: 'text/plain', title: 'LLM discovery index' },
  { href: '/llms-full.txt', type: 'text/plain', title: 'Full AI index' },
  { href: '/agent-manifest.json', type: 'application/json', title: 'Agent manifest' },
  { href: '/api/content-index.json', type: 'application/json', title: 'Structured content index' },
];
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{siteTitle}</title>
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="letsopen.ai" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="letsopen.ai RSS" href="/rss.xml" />
    {aiDiscoveryLinks.map((link) => (
      <link
        rel="alternate"
        type={link.type}
        title={link.title}
        href={new URL(link.href, Astro.site).href}
      />
    ))}
    {alternateLinks.map((link) => (
      <link
        rel="alternate"
        type={link.type}
        title={link.title}
        href={new URL(link.href, Astro.site).href}
      />
    ))}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Theme toggle (prevent flash) -->
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
