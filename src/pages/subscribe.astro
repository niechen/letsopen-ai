---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
---

<BaseLayout title="Subscribe" description="Get a weekly digest of the most important open source AI projects, tools, and analysis. Free, no spam.">
  <section class="subscribe-page">
    <div class="container content-width">
      <div class="subscribe-hero card">
        <span class="hero-kicker">Newsletter</span>
        <h1>Stay ahead of open source AI</h1>
        <p>
          A weekly digest of the projects, tools, and developments that matter. Curated by AI, edited by humans. No spam, no filler, just signal.
        </p>
      </div>

      <SubscribeForm variant="full" />

      <div class="what-you-get">
        <h2>What you'll get</h2>
        <div class="features">
          <div class="feature card">
            <span class="feature-index">01</span>
            <h3>Weekly digest</h3>
            <p>The most important developments in open source AI, curated and summarized.</p>
          </div>
          <div class="feature card">
            <span class="feature-index">02</span>
            <h3>New articles</h3>
            <p>Guides, comparisons, and analysis published during the week.</p>
          </div>
          <div class="feature card">
            <span class="feature-index">03</span>
            <h3>Projects to watch</h3>
            <p>Emerging open source AI projects worth paying attention to.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .subscribe-page {
    padding: 4.6rem 0;
  }

  .subscribe-hero {
    text-align: center;
    margin-bottom: 2rem;
    padding: clamp(1.2rem, 3vw, 2rem);
    background:
      linear-gradient(155deg, color-mix(in srgb, var(--accent) 10%, transparent), transparent 46%),
      var(--bg-card);
  }

  .hero-kicker {
    display: inline-block;
    margin-bottom: 0.75rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .subscribe-hero h1 {
    margin-bottom: 0.8rem;
    font-size: clamp(2rem, 7vw, 3.2rem);
  }

  .subscribe-hero p {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .what-you-get {
    margin-top: 3rem;
  }

  .what-you-get h2 {
    margin-bottom: 1.2rem;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .feature {
    padding: 1.15rem;
  }

  .feature-index {
    display: inline-block;
    margin-bottom: 0.65rem;
    font-size: 0.7rem;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .feature h3 {
    font-size: 1rem;
    margin-bottom: 0.45rem;
  }

  .feature p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
  }
</style>
