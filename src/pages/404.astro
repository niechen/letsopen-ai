---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not Found">
  <section class="not-found">
    <div class="container content-width not-found-inner">
      <div class="glyph">⟐</div>
      <h1>404</h1>
      <p>This page doesn't exist yet. The open source AI ecosystem moves fast; we may not have covered this topic yet.</p>
      <a href="/" class="btn btn-primary">Back to homepage</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding: 7rem 0;
  }

  .not-found-inner {
    text-align: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(150deg, color-mix(in srgb, var(--accent) 10%, transparent), transparent 50%),
      var(--bg-card);
    box-shadow: var(--shadow-md);
    padding: clamp(1.4rem, 4vw, 2.4rem);
  }

  .glyph {
    font-size: 3.4rem;
    color: var(--accent);
    opacity: 0.35;
    margin-bottom: 0.7rem;
  }

  h1 {
    font-size: clamp(2.4rem, 8vw, 4rem);
    margin-bottom: 0.7rem;
  }

  p {
    max-width: 450px;
    margin: 0 auto 1.5rem;
    color: var(--text-muted);
  }
</style>
