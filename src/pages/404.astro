---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not Found">
  <section class="not-found">
    <div class="container content-width" style="text-align: center;">
      <div class="glyph">⟐</div>
      <h1>404</h1>
      <p>This page doesn't exist yet. The open source AI ecosystem moves fast — maybe we haven't covered this topic yet.</p>
      <a href="/" class="btn btn-primary">Back to homepage</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding: 8rem 0;
  }
  .glyph {
    font-size: 4rem;
    color: var(--accent);
    opacity: 0.3;
    margin-bottom: 1rem;
  }
  h1 {
    font-size: 4rem;
    margin-bottom: 1rem;
  }
  p {
    max-width: 420px;
    margin: 0 auto 2rem;
    color: var(--text-muted);
  }
</style>
