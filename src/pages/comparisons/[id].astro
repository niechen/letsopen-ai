---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const comparisons = await getCollection('comparisons');
  return comparisons.map(comp => ({ params: { id: comp.id }, props: { comp } }));
}

const { comp } = Astro.props;
const { Content } = await render(comp);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(comp.data.pubDate);
---

<BaseLayout title={comp.data.title} description={comp.data.description} ogType="article">
  <article class="section">
    <div class="container content-width">
      <header class="comp-header">
        <div class="comp-meta">
          <span class="tag">Comparison</span>
          <time datetime={comp.data.pubDate.toISOString()}>{formattedDate}</time>
        </div>
        <h1>{comp.data.title}</h1>
        <p class="comp-desc">{comp.data.description}</p>
        {comp.data.verdict && (
          <div class="verdict-box">
            <strong>Quick verdict:</strong> {comp.data.verdict}
          </div>
        )}
      </header>

      <div class="prose">
        <Content />
      </div>

      <footer class="comp-footer">
        {comp.data.tags.length > 0 && (
          <div class="comp-tags">
            {comp.data.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
        <SubscribeForm variant="inline" />
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .comp-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .comp-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .comp-meta time {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .comp-header h1 {
    margin-bottom: 0.75rem;
  }
  .comp-desc {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  .verdict-box {
    background: var(--accent-subtle);
    border: 1px solid var(--accent);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    font-size: 0.95rem;
    color: var(--text-primary);
  }
  .verdict-box strong {
    color: var(--accent);
  }
  .comp-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }
  .comp-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
</style>
