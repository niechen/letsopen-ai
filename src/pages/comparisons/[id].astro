---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentHeader from '../../components/ContentHeader.astro';
import ContentFooter from '../../components/ContentFooter.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const comparisons = await getCollection('comparisons', ({ data }) => !data.draft);
  return comparisons.map(comp => ({ params: { id: comp.id }, props: { comp } }));
}

const { comp } = Astro.props;
const { Content } = await render(comp);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: comp.data.title,
  description: comp.data.description,
  datePublished: comp.data.pubDate.toISOString(),
  dateModified: comp.data.updatedDate?.toISOString() ?? comp.data.pubDate.toISOString(),
  author: {
    '@type': 'Organization',
    name: 'Let\'s Open',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Let\'s Open',
  },
  mainEntityOfPage: Astro.url.href,
  keywords: comp.data.tags?.join(', ') ?? '',
};
---

<BaseLayout title={comp.data.title} description={comp.data.description} ogType="article" schema={schema}>
  <article class="section">
    <div class="container content-width">
      <ContentHeader
        label="Comparison"
        title={comp.data.title}
        description={comp.data.description}
        pubDate={comp.data.pubDate}
        verdict={comp.data.verdict}
      />

      <div class="prose">
        <Content />
      </div>

      <ContentFooter tags={comp.data.tags} />
    </div>
  </article>
</BaseLayout>
