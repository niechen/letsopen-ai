---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { compareFreshnessDesc } from '../../utils/freshness';

const comparisons = await getCollection('comparisons', ({ data }) => !data.draft);
const sorted = comparisons.sort(compareFreshnessDesc);
---

<BaseLayout title="Comparisons" description="Side-by-side comparisons of open source AI tools. Quick verdicts, honest tradeoffs, clear recommendations.">
  <section class="section">
    <div class="container">
      <div class="page-header">
        <h1>Comparisons</h1>
        <p>Evaluating tools so you don't have to. Quick verdicts, honest tradeoffs, and clear recommendations for every comparison.</p>
      </div>
      <div class="grid-2">
        {sorted.map(comp => (
          <ArticleCard
            title={comp.data.title}
            description={comp.data.description}
            href={`/comparisons/${comp.id}`}
            pubDate={comp.data.pubDate}
            updatedDate={comp.data.updatedDate}
            tags={comp.data.tags}
            type="comparison"
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
