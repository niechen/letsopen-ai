---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';
import TopicIcon from '../../components/TopicIcon.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const hubs = await getCollection('hubs', ({ data }) => !data.draft);
  return hubs.map(hub => ({ params: { id: hub.id }, props: { hub } }));
}

const { hub } = Astro.props;
const { Content } = await render(hub);

const [articles, guides, comparisons] = await Promise.all([
  getCollection('articles', ({ data }) => !data.draft && data.hub === hub.id),
  getCollection('guides', ({ data }) => !data.draft && data.hub === hub.id),
  getCollection('comparisons', ({ data }) => !data.draft && data.hub === hub.id),
]);
const sortedArticles = articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const sortedGuides = guides.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const sortedComparisons = comparisons.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const relatedContent = [
  ...sortedArticles.map((item) => ({ title: item.data.title, url: `${Astro.site}articles/${item.id}` })),
  ...sortedGuides.map((item) => ({ title: item.data.title, url: `${Astro.site}guides/${item.id}` })),
  ...sortedComparisons.map((item) => ({ title: item.data.title, url: `${Astro.site}comparisons/${item.id}` })),
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: hub.data.title,
  description: hub.data.description,
  url: Astro.url.href,
  about: relatedContent.map((item) => ({
    '@type': 'Thing',
    name: item.title,
    url: item.url,
  })),
};
---

<BaseLayout title={hub.data.title} description={hub.data.description} ogType="website" schema={schema}>
  <article class="section">
    <div class="container content-width">
      <header class="hub-header card">
        {hub.data.icon && <TopicIcon name={hub.data.icon} size="2.35rem" class="hub-icon" label={`${hub.data.title} icon`} />}
        <h1>{hub.data.title}</h1>
        <p class="hub-desc">{hub.data.description}</p>
      </header>

      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  {sortedArticles.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 style="margin-bottom: 1.2rem;">Related articles</h2>
        <div class="grid-3">
          {sortedArticles.map(article => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              href={`/articles/${article.id}`}
              pubDate={article.data.pubDate}
              tags={article.data.tags}
              type={article.data.type}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {sortedGuides.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 style="margin-bottom: 1.2rem;">Related guides</h2>
        <div class="grid-3">
          {sortedGuides.map(guide => (
            <ArticleCard
              title={guide.data.title}
              description={guide.data.description}
              href={`/guides/${guide.id}`}
              pubDate={guide.data.pubDate}
              tags={guide.data.tags}
              type="guide"
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {sortedComparisons.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 style="margin-bottom: 1.2rem;">Related comparisons</h2>
        <div class="grid-3">
          {sortedComparisons.map(comp => (
            <ArticleCard
              title={comp.data.title}
              description={comp.data.description}
              href={`/comparisons/${comp.id}`}
              pubDate={comp.data.pubDate}
              tags={comp.data.tags}
              type="comparison"
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <SubscribeForm variant="full" />
    </div>
  </section>
</BaseLayout>

<style>
  .hub-header {
    margin-bottom: 2.5rem;
    padding: clamp(1.2rem, 2.5vw, 2.1rem);
    border-color: var(--border);
    background:
      linear-gradient(160deg, color-mix(in srgb, var(--accent) 8%, transparent), transparent 45%),
      var(--bg-card);
  }

  .hub-icon {
    display: inline-flex;
    margin-bottom: 0.8rem;
  }

  .hub-header h1 {
    margin-bottom: 0.6rem;
    font-size: clamp(1.95rem, 5vw, 3.2rem);
  }

  .hub-desc {
    font-size: 1.08rem;
    color: var(--text-secondary);
    max-width: 620px;
    margin: 0;
  }
</style>
