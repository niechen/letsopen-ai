---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TopicCard from '../components/TopicCard.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { getCollection } from 'astro:content';
import { compareFreshnessDesc } from '../utils/freshness';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const allGuides = await getCollection('guides', ({ data }) => !data.draft);
const allComparisons = await getCollection('comparisons', ({ data }) => !data.draft);
const hubs = await getCollection('hubs', ({ data }) => !data.draft);

const sortedHubs = hubs.sort((a, b) => a.data.order - b.data.order);

const featuredArticle = allArticles.find(a => a.data.featured);
const recentArticles = allArticles
  .filter(a => !a.data.featured)
  .sort(compareFreshnessDesc)
  .slice(0, 3);

const recentGuides = allGuides
  .sort(compareFreshnessDesc)
  .slice(0, 2);

const recentComparisons = allComparisons
  .sort(compareFreshnessDesc)
  .slice(0, 2);

const movementPrinciples = [
  {
    title: 'Transparency',
    description: 'People should be able to inspect the systems they depend on.',
  },
  {
    title: 'Security',
    description: 'Open systems can be audited, constrained, and adapted to real-world needs.',
  },
  {
    title: 'Sovereignty',
    description: 'Builders and organizations should be able to run AI on their own terms.',
  },
  {
    title: 'Access',
    description: 'The future of AI should not belong only to the largest closed platforms.',
  },
];

const builderPaths = [
  {
    label: 'Build an agent',
    title: 'Start with a practical blueprint',
    description: 'Assemble the smallest useful open agent app before adding frameworks, memory, tools, and multi-agent orchestration.',
    href: '/guides/open-source-agent-app-blueprint',
    action: 'Read the blueprint',
  },
  {
    label: 'Choose a stack',
    title: 'Assemble an open AI app stack',
    description: 'Understand the layers from models and inference to retrieval, orchestration, evaluation, and product interfaces.',
    href: '/guides/open-source-ai-stack-explained',
    action: 'Read the stack guide',
  },
  {
    label: 'Ship with tools',
    title: 'Pick practical builder tools',
    description: 'Compare the open source tools that are maintained, composable, documented, and useful for real AI application work.',
    href: '/guides/best-open-source-ai-tools-2026',
    action: 'See the tool list',
  },
  {
    label: 'Evaluate a project',
    title: 'Score what is worth adopting',
    description: 'Use a practical rubric for judging maintenance, source posture, deployment control, composability, governance, and eval coverage.',
    href: '/guides/how-to-evaluate-open-source-ai-projects',
    action: 'Use the rubric',
  },
  {
    label: 'For AI agents',
    title: 'Fetch machine-readable maps',
    description: 'Use structured indexes, text mirrors, llms.txt, and the agent manifest to route builder questions efficiently.',
    href: '/agents',
    action: 'Open agent access',
  },
];
---

<BaseLayout title="Home">
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-content animate-rise" style="--d: 0.05s;">
        <div class="hero-badge">Open source AI for security, transparency, and sovereignty</div>
        <h1 class="hero-title">
          Let's Open.<br />
          <span class="hero-accent">Build AI people can trust.</span>
        </h1>
        <p class="hero-desc">
          A builder-first map of open source AI projects, tools, models, infrastructure, and agent systems worth building on, with machine-readable endpoints for AI agents.
        </p>
        <div class="hero-actions">
          <a href="/guides/open-source-agent-app-blueprint" class="btn btn-primary">Start with the blueprint</a>
          <a href="/agents" class="btn btn-outline">For AI agents →</a>
        </div>
        <div class="hero-metrics">
          <span>Human-edited</span>
          <span>Machine-readable</span>
          <span>Open source first</span>
        </div>
      </div>
      <div class="hero-visual animate-rise" style="--d: 0.2s;">
        <div class="hero-frame">
          <div class="hero-glyph">⟐</div>
          <div class="hero-lines">
            <span></span>
            <span></span>
            <span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Builder paths -->
  <section class="section builder-section">
    <div class="container">
      <div class="section-header section-header-stack">
        <div>
          <div class="section-label">For builders and agents</div>
          <h2>Find the next open component to build with.</h2>
        </div>
        <p class="section-intro">Use letsopen.ai as a map for choosing open models, agent frameworks, local runtimes, infrastructure, and workflow tools.</p>
      </div>
      <div class="grid-4">
        {builderPaths.map((path) => (
          <a href={path.href} class="card builder-path-card animate-rise">
            <span class="builder-path-label">{path.label}</span>
            <h3>{path.title}</h3>
            <p>{path.description}</p>
            <span class="builder-path-action">{path.action} -></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Article -->
  {featuredArticle && (
    <section class="section">
      <div class="container">
        <div class="section-label">Featured</div>
        <a href={`/articles/${featuredArticle.id}`} class="featured-card animate-rise" style="--d: 0.08s;">
          <div class="featured-meta">
            <span class="tag">{featuredArticle.data.type}</span>
            <time datetime={featuredArticle.data.pubDate.toISOString()}>
              {new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).format(featuredArticle.data.pubDate)}
            </time>
          </div>
          <h2 class="featured-title">{featuredArticle.data.title}</h2>
          <p class="featured-desc">{featuredArticle.data.description}</p>
          <span class="featured-link">Read article →</span>
        </a>
      </div>
    </section>
  )}

  <!-- Why open matters -->
  <section class="section">
    <div class="container">
      <div class="section-header section-header-stack">
        <div>
          <div class="section-label">Why open matters</div>
          <h2>Open source AI is about more than code.</h2>
        </div>
        <p class="section-intro">It is about trust, transparency, control, and making AI something people can actually govern.</p>
      </div>
      <div class="grid-4">
        {movementPrinciples.map((item) => (
          <div class="card principle-card animate-rise">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Topic Hubs -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Topics</h2>
        <a href="/topics" class="section-link">View all →</a>
      </div>
      <div class="grid-4">
        {sortedHubs.map(hub => (
          <TopicCard
            title={hub.data.title}
            description={hub.data.description}
            href={`/topics/${hub.id}`}
            icon={hub.data.icon}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Articles -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Latest</h2>
      </div>
      <div class="grid-3">
        {recentArticles.map(article => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            href={`/articles/${article.id}`}
            pubDate={article.data.pubDate}
            updatedDate={article.data.updatedDate}
            tags={article.data.tags}
            type={article.data.type}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Guides & Comparisons -->
  <section class="section">
    <div class="container">
      <div class="grid-2">
        <div>
          <div class="section-header">
            <h3>Guides</h3>
            <a href="/guides" class="section-link">All guides →</a>
          </div>
          {recentGuides.map(guide => (
            <ArticleCard
              title={guide.data.title}
              description={guide.data.description}
              href={`/guides/${guide.id}`}
              pubDate={guide.data.pubDate}
              updatedDate={guide.data.updatedDate}
              tags={guide.data.tags}
            />
          ))}
        </div>
        <div>
          <div class="section-header">
            <h3>Comparisons</h3>
            <a href="/comparisons" class="section-link">All comparisons →</a>
          </div>
          {recentComparisons.map(comp => (
            <ArticleCard
              title={comp.data.title}
              description={comp.data.description}
              href={`/comparisons/${comp.id}`}
              pubDate={comp.data.pubDate}
              updatedDate={comp.data.updatedDate}
              tags={comp.data.tags}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Operating model -->
  <section class="section">
    <div class="container">
      <div class="operating-model card">
        <div>
          <div class="section-label">How this site works</div>
          <h2>AI-operated. Human-edited. Open by design.</h2>
          <p>
            Let's Open uses AI to monitor the ecosystem, draft structured coverage, maintain machine-readable discovery layers, and keep the site current. Human judgment still decides what deserves trust, attention, and publication.
          </p>
        </div>
        <div class="operating-actions">
          <a href="/how-we-work" class="btn btn-outline">See the operating model</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Subscribe CTA -->
  <section class="section">
    <div class="container">
      <SubscribeForm variant="full" />
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding: 5.4rem 0 4.3rem;
  }

  .hero .container {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 2.5rem;
  }

  .hero-content {
    max-width: 720px;
    animation-delay: var(--d);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--accent);
    margin-bottom: 1.18rem;
    padding: 0.34em 0.82em;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent-subtle) 80%, transparent);
  }

  .hero-title {
    font-size: clamp(2.2rem, 6vw, 4.8rem);
    line-height: 1;
    margin-bottom: 1.25rem;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .hero-accent {
    color: var(--accent);
  }

  .hero-desc {
    font-size: 1.07rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin-bottom: 1.6rem;
    line-height: 1.72;
  }

  .hero-actions {
    display: flex;
    gap: 0.78rem;
    flex-wrap: wrap;
    margin-bottom: 1.1rem;
  }

  .hero-metrics {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .hero-metrics span {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.32em 0.7em;
    background: color-mix(in srgb, var(--bg-card) 88%, transparent);
  }

  .hero-visual {
    animation-delay: var(--d);
  }

  .hero-frame {
    display: grid;
    place-items: center;
    min-height: 380px;
    border: 1px solid var(--border);
    border-radius: 22px;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--accent) 10%, transparent), transparent 52%),
      var(--bg-card);
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
  }

  .hero-glyph {
    font-size: clamp(6rem, 16vw, 10rem);
    color: var(--accent);
    opacity: 0.16;
    line-height: 1;
  }

  .hero-lines {
    position: absolute;
    inset: 1.2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    pointer-events: none;
  }

  .hero-lines span {
    border-top: 1px solid color-mix(in srgb, var(--accent) 20%, var(--border));
  }

  .hero-lines span:nth-child(2) {
    margin-left: 30%;
  }

  .hero-lines span:nth-child(3) {
    margin-left: 58%;
  }

  /* Section helpers */
  .section-label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 0.82rem;
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 1.4rem;
    gap: 1.5rem;
  }

  .section-header-stack {
    align-items: end;
  }

  .section-intro {
    max-width: 420px;
    font-size: 0.96rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .section-link {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .section-link:hover {
    color: var(--accent);
  }

  /* Featured card */
  .featured-card {
    display: block;
    background:
      linear-gradient(150deg, color-mix(in srgb, var(--accent) 12%, transparent), transparent 50%),
      var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: clamp(1.45rem, 3vw, 2.6rem);
    transition: border-color 0.2s ease, transform 0.2s ease;
    color: inherit;
    animation-delay: var(--d);
  }

  .featured-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    color: inherit;
  }

  .featured-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.88rem;
    flex-wrap: wrap;
  }

  .featured-meta time {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .featured-title {
    font-size: clamp(1.55rem, 3vw, 2.4rem);
    margin-bottom: 0.7rem;
    text-wrap: balance;
  }

  .featured-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 640px;
    margin-bottom: 1.1rem;
  }

  .featured-link {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .principle-card h3 {
    margin-bottom: 0.4rem;
  }

  .principle-card p {
    margin-bottom: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .builder-section {
    background: color-mix(in srgb, var(--bg-secondary) 58%, transparent);
  }

  .builder-path-card {
    display: flex;
    min-height: 270px;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .builder-path-card:hover {
    color: inherit;
  }

  .builder-path-label {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 0.85rem;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border));
    border-radius: 999px;
    padding: 0.24em 0.62em;
    background: var(--accent-subtle);
    color: var(--accent);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .builder-path-card h3 {
    font-size: 1.12rem;
    margin-bottom: 0.55rem;
  }

  .builder-path-card p {
    flex: 1;
    margin-bottom: 1rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .builder-path-action {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .operating-model {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    padding: 1.7rem;
    border-radius: var(--radius-lg);
    background:
      linear-gradient(150deg, color-mix(in srgb, var(--accent) 10%, transparent), transparent 42%),
      var(--bg-card);
  }

  .operating-model h2 {
    margin-bottom: 0.65rem;
    font-size: clamp(1.4rem, 2.8vw, 2rem);
  }

  .operating-model p {
    max-width: 700px;
    margin-bottom: 0;
    color: var(--text-secondary);
  }

  .operating-actions {
    flex-shrink: 0;
  }

  .animate-rise {
    animation-name: rise-in;
    animation-duration: 0.58s;
    animation-fill-mode: both;
    animation-timing-function: ease;
    animation-delay: var(--d, 0s);
  }

  @media (max-width: 900px) {
    .hero .container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-desc {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-metrics {
      justify-content: center;
    }

    .hero-frame {
      min-height: 260px;
      max-width: 680px;
      margin: 0 auto;
    }

    .featured-card {
      padding: 1.5rem;
    }

    .section-header-stack {
      align-items: flex-start;
      flex-direction: column;
    }

    .operating-model {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 4.1rem;
    }

    .hero-frame {
      min-height: 210px;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }
  }
</style>
