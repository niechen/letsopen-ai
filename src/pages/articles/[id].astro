---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentHeader from '../../components/ContentHeader.astro';
import ContentFooter from '../../components/ContentFooter.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map(article => ({ params: { id: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.pubDate.toISOString(),
  dateModified: article.data.updatedDate?.toISOString() ?? article.data.pubDate.toISOString(),
  author: {
    '@type': 'Organization',
    name: 'Let\'s Open',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Let\'s Open',
  },
  mainEntityOfPage: Astro.url.href,
  keywords: article.data.tags?.join(', ') ?? '',
};
---

<BaseLayout title={article.data.title} description={article.data.description} ogType="article" schema={schema}>
  <article class="section">
    <div class="container content-width">
      <ContentHeader
        label={article.data.type}
        title={article.data.title}
        description={article.data.description}
        pubDate={article.data.pubDate}
        hub={article.data.hub}
      />

      <div class="prose">
        <Content />
      </div>

      <ContentFooter tags={article.data.tags} />
    </div>
  </article>
</BaseLayout>
