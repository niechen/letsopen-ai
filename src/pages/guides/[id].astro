---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentHeader from '../../components/ContentHeader.astro';
import ContentFooter from '../../components/ContentFooter.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map(guide => ({ params: { id: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: guide.data.title,
  description: guide.data.description,
  datePublished: guide.data.pubDate.toISOString(),
  dateModified: guide.data.updatedDate?.toISOString() ?? guide.data.pubDate.toISOString(),
  author: {
    '@type': 'Organization',
    name: 'Let\'s Open',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Let\'s Open',
  },
  mainEntityOfPage: Astro.url.href,
  keywords: guide.data.tags?.join(', ') ?? '',
};
---

<BaseLayout title={guide.data.title} description={guide.data.description} ogType="article" schema={schema}>
  <article class="section">
    <div class="container content-width">
      <ContentHeader
        label="Guide"
        title={guide.data.title}
        description={guide.data.description}
        pubDate={guide.data.pubDate}
      />

      <div class="prose">
        <Content />
      </div>

      <ContentFooter tags={guide.data.tags} />
    </div>
  </article>
</BaseLayout>
