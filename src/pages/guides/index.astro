---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { compareFreshnessDesc } from '../../utils/freshness';

const guides = await getCollection('guides', ({ data }) => !data.draft);
const sorted = guides.sort(compareFreshnessDesc);
const startGuide = sorted.find((guide) => guide.id === 'open-source-agent-app-blueprint');
const guideList = startGuide ? sorted.filter((guide) => guide.id !== startGuide.id) : sorted;
---

<BaseLayout title="Guides" description="Practical guides for navigating the open source AI ecosystem. Curated, opinionated, and regularly updated.">
  <section class="section">
    <div class="container">
      <div class="page-header">
        <h1>Guides</h1>
        <p>Practical, opinionated guides for builders. Each one is designed to save you time and help you make better decisions.</p>
      </div>

      {startGuide && (
        <a href={`/guides/${startGuide.id}`} class="guide-spotlight card">
          <div>
            <span class="spotlight-label">Start here</span>
            <h2>{startGuide.data.title}</h2>
            <p>{startGuide.data.description}</p>
          </div>
          <span class="spotlight-action">Read the blueprint -></span>
        </a>
      )}

      <div class="grid-2">
        {guideList.map(guide => (
          <ArticleCard
            title={guide.data.title}
            description={guide.data.description}
            href={`/guides/${guide.id}`}
            pubDate={guide.data.pubDate}
            updatedDate={guide.data.updatedDate}
            tags={guide.data.tags}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .guide-spotlight {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.3rem;
    align-items: end;
    margin-bottom: 1.5rem;
    padding: clamp(1.35rem, 3vw, 2rem);
    color: inherit;
    text-decoration: none;
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    background:
      linear-gradient(155deg, color-mix(in srgb, var(--accent) 12%, transparent), transparent 48%),
      var(--bg-card);
  }

  .guide-spotlight:hover {
    color: inherit;
  }

  .spotlight-label {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 0.8rem;
    border: 1px solid color-mix(in srgb, var(--accent) 48%, var(--border));
    border-radius: 999px;
    padding: 0.25em 0.65em;
    background: var(--accent-subtle);
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .guide-spotlight h2 {
    margin-bottom: 0.55rem;
    font-size: clamp(1.35rem, 2.6vw, 2rem);
  }

  .guide-spotlight p {
    max-width: 760px;
    margin: 0;
  }

  .spotlight-action {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .guide-spotlight {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .spotlight-action {
      white-space: normal;
    }
  }
</style>
